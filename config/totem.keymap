/*
 * TOTEM matrix validation keymap.
 *
 * PURPOSE: prove that every one of the 38 switches works, and that each one
 * maps to the position you expect. Every key sends a different character.
 * There are no home-row mods and no combos, so nothing can mask a dead key.
 *
 * HOW TO TEST
 *   Step 1 - LEFT half alone, over USB. Open a text editor. Press every
 *   left-half key, left to right, top row downward. Expect exactly:
 *          1 2 3 4 5    Q W E R T    A S D F G H    Z X C
 *   This proves the left matrix, the transform and USB HID all work.
 *
 *   Step 2 - RIGHT half alone, over USB. It will type NOTHING. That is
 *   correct and not a fault: the right half is the split peripheral, and ZMK
 *   compiles the HID stack only for the central (app/CMakeLists.txt:47). Read
 *   its serial log instead, see totem.conf. Press each right-half key and
 *   watch for one "Sending event at r,c" line per press. 19 keys, 19 lines.
 *
 *   Step 3 - BOTH halves. Left over USB, right switched on. Press everything.
 *   Expect the whole string:
 *          1234567890 QWERTYUIOP ASDFGHJKL;'\ ZXCVBN
 *   This is the only step that proves the halves are paired and that the
 *   right half's col-offset of 5 is correct.
 *
 * READING THE RESULT
 *   one character missing   -> that switch or its solder joint is bad
 *   two keys, same output   -> a row or column pin is shorted
 *   a whole row missing     -> that row pin is the problem   (xiao_d 0..3)
 *   a whole column missing  -> that column pin is the problem (xiao_d 4,5,8,9,10)
 *   steps 1 and 2 pass, step 3 gives only left-half characters
 *                           -> the halves are not paired. Hold "\" and press
 *                              the top-left key to clear bonds, then repair.
 *   step 3 gives wrong characters from the right half only
 *                           -> col-offset or the right col-gpios order is wrong
 *
 * RECOVERY: press the XIAO reset button twice, quickly. The board mounts as a
 * USB drive. Drag a .uf2 onto it. This works whatever the firmware does.
 *
 * UTILITY LAYER: hold either outer key. The left one types "A", the right one
 * types "\". Both reach the same layer, so it works with one half alone.
 *   "1" key  -> bootloader
 *   "2" key  -> reset
 *   "Q" key  -> clear Bluetooth bonds
 *   "W" key  -> toggle USB / Bluetooth output
 * Every other key on that layer does nothing, so an accidental hold is safe.
 *
 * IF NOTHING TYPES AT ALL over USB, suspect the output endpoint before the
 * matrix. ZMK saves the USB-or-Bluetooth choice in the settings partition, and
 * a .uf2 update does not erase it. Hold an outer key and press "W" to force
 * USB, or press "Q" to drop the stale bonds. Both work locally and do not need
 * HID output to be functioning.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define TEST 0
#define UTIL 1

/ {
    keymap {
        compatible = "zmk,keymap";

        test_layer {
            display-name = "TEST";
//       ┌─────┬─────┬─────┬─────┬─────┐             ┌─────┬─────┬─────┬─────┬─────┐
//       │  1  │  2  │  3  │  4  │  5  │             │  6  │  7  │  8  │  9  │  0  │
//       ├─────┼─────┼─────┼─────┼─────┤             ├─────┼─────┼─────┼─────┼─────┤
//       │  Q  │  W  │  E  │  R  │  T  │             │  Y  │  U  │  I  │  O  │  P  │
// ┌─────┼─────┼─────┼─────┼─────┼─────┤             ├─────┼─────┼─────┼─────┼─────┼─────┐
// │  A  │  S  │  D  │  F  │  G  │  H  │             │  J  │  K  │  L  │  ;  │  '  │  \  │
// └─────┴─────┴─────┼─────┼─────┼─────┤             ├─────┼─────┼─────┼─────┴─────┴─────┘
//                   │  Z  │  X  │  C  │             │  V  │  B  │  N  │
//                   └─────┴─────┴─────┘             └─────┴─────┴─────┘
            bindings = <
        &kp N1   &kp N2   &kp N3   &kp N4   &kp N5      &kp N6   &kp N7   &kp N8   &kp N9   &kp N0
        &kp Q    &kp W    &kp E    &kp R    &kp T       &kp Y    &kp U    &kp I    &kp O    &kp P
&lt UTIL A   &kp S    &kp D    &kp F    &kp G    &kp H       &kp J    &kp K    &kp L    &kp SEMI &kp SQT  &lt UTIL BSLH
                          &kp Z    &kp X    &kp C       &kp V    &kp B    &kp N
            >;
        };

        util_layer {
            display-name = "UTIL";
            bindings = <
        &bootloader  &sys_reset    &none  &none  &none      &none  &none  &none  &none  &none
        &bt BT_CLR   &out OUT_TOG  &none  &none  &none      &none  &none  &none  &none  &none
&trans  &none        &none         &none  &none  &none      &none  &none  &none  &none  &none  &trans
                                   &none  &none  &none      &none  &none  &none
            >;
        };
    };
};
